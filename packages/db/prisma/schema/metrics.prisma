  // They are Float, not Decimal: the API changes a Decimal value to a BigInt,
  // and a USD value has a fractional part.

  /// @zod.number.nonnegative()
  totalBlobBaseFeeUsd       Float? @map("total_blob_base_fee_usd")
  /// @zod.number.nonnegative()
  totalBlobAsCalldataFeeUsd Float? @map("total_blob_as_calldata_fee_usd")
  /// @zod.number.nonnegative()
  totalBlobMaxFeeUsd        Float? @map("total_blob_max_fee_usd")

  @@unique([periodStart, category, rollup])
  @@map("yearly_metrics")
}
