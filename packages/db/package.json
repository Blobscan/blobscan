{
  "name": "@blobscan/db",
  "version": "0.31.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "files": [
    "./prisma/zod-utils.ts",
    "./prisma/zod",
    "./prisma/enums"
  ],
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "type-check": "tsc --noEmit",
    "db:generate": "pnpm with-env prisma generate && tsx ./prisma/patch-zod.ts",
    "db:migrate": "pnpm with-env prisma migrate dev",
    "db:seed": "pnpm with-env prisma db seed",
    "db:reset": "pnpm with-env prisma migrate reset",
    "dev": "pnpm with-env prisma studio --port 5556",
    "with-env": "dotenv -e ../../.env --",
    "with-env:test": "dotenv -e ../../.env.test --",
    "test": "pnpm with-env:test vitest",
    "test:ui": "pnpm with-env:test vitest --ui"
  },
  "dependencies": {
    "@blobscan/dayjs": "workspace:^0.1.0",
    "@blobscan/logger": "workspace:^0.1.4",
    "@blobscan/open-telemetry": "workspace:^0.0.10",
    "@blobscan/zod": "workspace:^0.1.0",
    "@prisma/client": "^6.19.3",
    "@prisma/generator-helper": "^6.19.3",
    "decimal.js": "^10.6.0",
    "prisma": "^6.19.3",
    "zod-prisma": "^0.5.4"
  },
  "devDependencies": {
    "@blobscan/chains": "workspace:^0.5.0",
    "@faker-js/faker": "^10.6.0",
    "js-sha256": "^0.9.0",
    "ora": "^8.1.1",
    "tsx": "^4.23.15"
  },
  "eslintConfig": {
    "root": true,
    "ignorePatterns": [
      "prisma/zod/*.ts",
      "prisma/enums/*.ts"
    ],
    "extends": [
      "@blobscan/eslint-config/base"
    ]
  }
}
