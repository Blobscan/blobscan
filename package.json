{
  "name": "blobscan-monorepo",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "turbo build",
    "changeset:release": "pnpm build && changeset publish",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "db:generate": "turbo db:generate",
    "db:studio": "pnpm -F db dev",
    "dev": "turbo dev --parallel",
    "format": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,md,json}\" --ignore-path .gitignore",
    "lint": "turbo lint && manypkg check",
    "lint:fix": "turbo lint:fix && manypkg fix",
    "start": "turbo start",
    "test": "pnpm with-env:test vitest",
    "test:dagster": "pnpm -F @blobscan/dagster test",
    "coverage": "pnpm with-env:test vitest --coverage",
    "test:ui": "pnpm with-env:test vitest --ui",
    "test:setup": "turbo test:setup",
    "test:dev": "pnpm test:setup && pnpm test",
    "type-check": "turbo type-check",
    "propagator": "pnpm with-env pnpm -F blob-propagation-jobs-cli start",
    "svg:format": "turbo svg:format",
    "validate": "turbo lint type-check && manypkg check && pnpm test",
    "with-env": "dotenv -e .env --",
    "with-env:test": "dotenv -e .env.test --"
  },
  "devDependencies": {
    "@blobscan/eslint-config": "workspace:^0.0.1",
    "@blobscan/svgo-config": "workspace:^0.0.1",
    "@blobscan/tailwind-config": "workspace:^0.0.1",
    "@blobscan/test": "workspace:^0.0.1",
    "@blobscan/tsconfig": "workspace:^0.0.1",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@ianvs/prettier-plugin-sort-imports": "^3.7.2",
    "@manypkg/cli": "^0.25.1",
    "@types/command-line-args": "^5.2.2",
    "@types/command-line-usage": "^5.0.3",
    "@types/node": "^24.19.2",
    "@types/prettier": "^2.7.3",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^7.2.1",
    "msw": "^2.3.1",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.2.8",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "5.5.3",
    "vite": "6.4.4",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^5.1.1"
  },
  "manypkg": {
    "workspaceProtocol": "require"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.5.3",
      "zod": "4.6.7",
      "zod-to-json-schema": "3.25.2",
      "@prisma/instrumentation>@opentelemetry/instrumentation": "0.220.0",
      "@opentelemetry/core@>=2.0.0 <2.8.0": "2.9.0",
      "cross-spawn@<6.0.6": "6.0.6",
      "cross-spawn@>=7.0.0 <7.0.5": "7.0.5",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "tar@<=7.5.20": "7.5.21",
      "fast-xml-parser@>=4.1.3 <4.5.5": "4.5.5",
      "fast-xml-parser@>=5.0.0 <5.7.0": "5.7.0",
      "protobufjs@<7.6.5": "7.6.5",
      "@protobufjs/utf8@<=1.1.0": "1.1.1",
      "@grpc/grpc-js@>=1.14.0 <1.14.5": "1.14.5",
      "h3@<1.15.9": "1.15.9",
      "defu@<=6.1.4": "6.1.5",
      "path-to-regexp@<0.1.13": "0.1.13",
      "node-forge@<1.4.0": "1.4.0",
      "proxy-addr@<2.0.8": "2.0.8",
      "serialize-javascript@<7.1.3": "7.1.4",
      "flatted@<=3.4.1": "3.4.2",
      "lodash@<=4.17.23": "4.18.0",
      "@babel/plugin-transform-modules-systemjs@<=7.29.3": "7.29.4",
      "fast-uri@<3.1.9": "3.1.9",
      "browserslist@<=4.28.6": "4.28.7",
      "postcss@<=8.5.22": "8.5.23",
      "nanoid@<3.3.18": "3.3.18",
      "source-map-js@<1.2.2": "1.2.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "vite@<=6.4.3": "6.4.4",
      "axios@>=0.19.0 <0.34.0": "0.34.0",
      "axios@>=1.0.0 <1.20.0": "1.20.0",
      "ajv@<6.14.0": "6.14.0",
      "follow-redirects@<=1.16.0": "1.16.1",
      "qs@<6.16.0": "6.16.0",
      "baseline-browser-mapping@<2.11.0": "2.11.0",
      "@babel/core@<=7.29.0": "7.29.6",
      "postcss-selector-parser@<7.1.6": "7.1.7",
      "@sentry/webpack-plugin>uuid": "11.1.1",
      "bullmq>uuid": "11.1.1"
    },
    "patchedDependencies": {
      "trpc-openapi@1.2.0": "patches/trpc-openapi@1.2.0.patch"
    }
  }
}
