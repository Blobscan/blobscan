{
  "name": "@blobscan/web",
  "version": "0.56.0",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true pnpm build",
    "build": "NODE_ENV=production pnpm with-env next build --webpack",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "pnpm with-env next dev -p 3000 --webpack",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "start": "pnpm with-env next start",
    "svg:format": "svgo -r ./src/icons ./public",
    "type-check": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@blobscan/api": "workspace:^4.2.0",
    "@blobscan/blob-decoder": "workspace:^0.2.3",
    "@blobscan/blob-storage-manager": "workspace:^4.2.0",
    "@blobscan/chains": "workspace:^0.5.0",
    "@blobscan/dayjs": "workspace:^0.1.1",
    "@blobscan/db": "workspace:^0.31.1",
    "@blobscan/env": "workspace:^0.6.0",
    "@blobscan/eth-format": "workspace:^0.1.0",
    "@blobscan/logger": "workspace:^0.1.4",
    "@blobscan/open-telemetry": "workspace:^0.0.11",
    "@blobscan/rollups": "workspace:^4.1.0",
    "@blobscan/zod": "workspace:^0.1.1",
    "@floating-ui/react": "^0.26.23",
    "@fontsource/inter": "^4.5.15",
    "@fontsource/public-sans": "^4.5.12",
    "@headlessui/react": "^2.1.0",
    "@headlessui/tailwindcss": "^0.1.3",
    "@heroicons/react": "^2.0.17",
    "@next/bundle-analyzer": "~16.4.3",
    "@react-spring/web": "^9.7.2",
    "@sentry/nextjs": "^11.8.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.5",
    "@trpc/client": "^11.19.0",
    "@trpc/next": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "class-variance-authority": "^0.7.0",
    "classnames": "^2.3.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "ioredis": "^5.3.2",
    "next": "~16.4.3",
    "next-themes": "^0.2.1",
    "rate-limiter-flexible": "^7.0.0",
    "react": "18.2.0",
    "react-blockies": "^1.4.1",
    "react-dom": "18.2.0",
    "react-loading-skeleton": "^3.3.1",
    "react-tailwindcss-datepicker": "1.6.6",
    "sharp": "^0.35.5",
    "superjson": "1.9.1",
    "tailwind-gradient-mask-image": "^1.2.0",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@types/react": "^18.3.27",
    "@types/react-blockies": "^1.4.1",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.1"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@blobscan/eslint-config/base",
      "@blobscan/eslint-config/nextjs",
      "@blobscan/eslint-config/react"
    ]
  },
  "nextBundleAnalysis": {
    "budget": 358400,
    "budgetPercentIncreaseRed": 20,
    "minimumChangeThreshold": 500,
    "showDetails": true
  }
}
