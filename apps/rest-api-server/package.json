{
  "name": "@blobscan/rest-api-server",
  "version": "0.17.0",
  "private": true,
  "scripts": {
    "build": "ncc build src/index.ts --target es2020 --minify",
    "postbuild": "tsx ./scripts/postbuild.ts",
    "clean": "git clean -xdf node_modules",
    "dev": "pnpm with-env tsx watch --require ./scripts/init-bucket.ts ./src/index.ts",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "start": "pnpm with-env node dist/index.js",
    "profile": " tsx --env-file=../../.env --prof --require ./src/instrumentation.ts src/index.ts",
    "with-env": "dotenv -e ../../.env --",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@blobscan/api": "workspace:^4.1.0",
    "@blobscan/blob-propagator": "workspace:^4.1.0",
    "@blobscan/blob-storage-manager": "workspace:^4.1.0",
    "@blobscan/chains": "workspace:^0.5.0",
    "@blobscan/db": "workspace:^0.31.0",
    "@blobscan/env": "workspace:^0.5.0",
    "@blobscan/errors": "workspace:^0.0.2",
    "@blobscan/logger": "workspace:^0.1.5",
    "@blobscan/open-telemetry": "workspace:^0.0.10",
    "@blobscan/price-feed": "workspace:^0.1.0",
    "@blobscan/rollups": "workspace:^4.1.0",
    "@blobscan/syncers": "workspace:^0.7.0",
    "@blobscan/zod": "workspace:^0.1.0",
    "@opentelemetry/instrumentation-express": "0.68.0",
    "@sentry/node": "^11.8.0",
    "body-parser": "^1.20.9",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "ioredis": "^5.3.2",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^4.6.2",
    "trpc-to-openapi": "^3.3.3",
    "viem": "^2.17.4",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/morgan": "^1.9.4",
    "@types/swagger-ui-express": "^4.1.3",
    "@vercel/ncc": "^0.45.0",
    "zx": "^8.1.4"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@blobscan/eslint-config/base"
    ]
  }
}
